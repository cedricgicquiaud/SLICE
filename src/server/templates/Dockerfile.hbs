# Multi-stage build for the {{apiName}} MCP server (generated by SLICE).

# --- build stage: compile TypeScript to dist/ ---
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
RUN npm run build

# --- runtime stage: prod deps + compiled output only ---
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json ./
RUN npm install --omit=dev
COPY --from=builder /app/dist ./dist
# HTTP Streamable transport listens on MCP_HTTP_PORT (default 8787).
EXPOSE 8787
CMD ["node", "dist/index.js"]
