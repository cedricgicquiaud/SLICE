# Base URL for the upstream {{apiName}} API.
UPSTREAM_BASE_URL={{baseUrl}}

# How the MCP gets the upstream credential:
#   env   (default) — read it from the variables below (self-host).
#   relay           — forward the caller's own Authorization header, never
#                     stored. Used when SLICE hosts the server for you.
# MCP_AUTH_MODE=env
{{#ifEquals upstreamAuth.type "apiKey"}}

# Forwarded to the upstream API as `{{upstreamAuth.headerName}}: <value>`.
UPSTREAM_API_KEY=
{{/ifEquals}}
{{#ifEquals upstreamAuth.type "bearer"}}

# Forwarded to the upstream API as `Authorization: Bearer <value>`.
UPSTREAM_BEARER_TOKEN=
{{/ifEquals}}
{{#ifEquals upstreamAuth.type "oauth2"}}

# OAuth 2.0 client_credentials. The MCP signs in by itself: it exchanges these
# at the token endpoint ({{upstreamAuth.tokenUrl}}{{#if scopesJoined}}, scopes: {{scopesJoined}}{{/if}})
# for a short-lived access token, then calls the API with it.
UPSTREAM_OAUTH_CLIENT_ID=
UPSTREAM_OAUTH_CLIENT_SECRET=
{{/ifEquals}}
{{#if mcpServerToken}}

# Required when the MCP exposes its HTTP transport. Agents must send
# this value as `Authorization: Bearer <value>` to reach the server.
MCP_SERVER_TOKEN={{mcpServerToken}}
{{/if}}
{{#unless modeLocalOnly}}

# Port the HTTP transport binds to. Default 8787 matches the README.
MCP_HTTP_PORT=8787
{{/unless}}
