/**
 * OAuth2 client_credentials token manager (self-host, MCP_AUTH_MODE=env).
 * Generated by SLICE — do not edit by hand. The MCP fetches its own bearer
 * token from the token endpoint, caches it until shortly before expiry, and
 * dedups concurrent fetches. The client secret is read from the environment
 * and never logged or thrown.
 */
const TOKEN_URL = '{{upstreamAuth.tokenUrl}}';
const SCOPES = '{{scopesJoined}}';

// Refresh proactively a little before the server-stated expiry to avoid racing
// the clock; fall back to a short finite TTL when the server omits expires_in.
const REFRESH_MARGIN_MS = 30_000;
const DEFAULT_TTL_S = 300;

let cached: { token: string; expiresAt: number } | null = null;
let inFlight: Promise<string> | null = null;

async function fetchToken(): Promise<string> {
  const clientId = process.env.UPSTREAM_OAUTH_CLIENT_ID ?? '';
  const clientSecret = process.env.UPSTREAM_OAUTH_CLIENT_SECRET ?? '';
  if (!clientId || !clientSecret) {
    throw new Error('UPSTREAM_OAUTH_CLIENT_ID and UPSTREAM_OAUTH_CLIENT_SECRET are required for this MCP.');
  }

  const basic = Buffer.from(`${clientId}:${clientSecret}`).toString('base64');
  const body = new URLSearchParams({ grant_type: 'client_credentials' });
  if (SCOPES) body.set('scope', SCOPES);

  let res: Response;
  try {
    res = await fetch(TOKEN_URL, {
      method: 'POST',
      headers: {
        Authorization: `Basic ${basic}`,
        'Content-Type': 'application/x-www-form-urlencoded',
        Accept: 'application/json',
      },
      body: body.toString(),
    });
  } catch {
    // Never surface the secret, the Basic header, or low-level details.
    throw new Error('Failed to reach the OAuth token endpoint.');
  }

  if (!res.ok) {
    // Status only — the response body can echo back credential hints.
    throw new Error(`Failed to obtain OAuth token: ${res.status} ${res.statusText}`);
  }

  const json = (await res.json()) as {
    access_token?: string;
    expires_in?: number;
    token_type?: string;
  };
  if (json.token_type && json.token_type.toLowerCase() !== 'bearer') {
    throw new Error(`Unsupported OAuth token_type: ${json.token_type}`);
  }
  if (!json.access_token) {
    throw new Error('OAuth token response had no access_token.');
  }

  const ttlS = typeof json.expires_in === 'number' ? json.expires_in : DEFAULT_TTL_S;
  cached = { token: json.access_token, expiresAt: Date.now() + ttlS * 1000 - REFRESH_MARGIN_MS };
  return json.access_token;
}

/** Return a valid access token, fetching (and caching) one if needed. */
export async function getAccessToken(): Promise<string> {
  if (cached && Date.now() < cached.expiresAt) return cached.token;
  // Dedup concurrent fetches — the first caller starts it, the rest await it.
  if (inFlight) return inFlight;
  inFlight = fetchToken().finally(() => {
    inFlight = null;
  });
  return inFlight;
}

/** Drop the cached token so the next call fetches a fresh one (used on 401). */
export function invalidateToken(): void {
  cached = null;
}
