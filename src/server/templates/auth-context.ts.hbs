/**
 * Per-request auth context for relay mode. Generated by SLICE — do not edit.
 *
 * In relay mode the hosted MCP forwards the caller's own `Authorization`
 * header to the upstream API instead of reading a stored secret. The HTTP
 * entry point captures that header and runs each request inside `authStore`,
 * so `http-client.ts` can read it per request without threading it through
 * every tool signature. Nothing is ever stored.
 */
import { AsyncLocalStorage } from 'node:async_hooks';

export const authStore = new AsyncLocalStorage<{ authorization: string }>();

/**
 * The bearer token the caller relayed on this request, or `undefined` when no
 * well-formed `Authorization: Bearer <value>` is present. Case-insensitive on
 * the scheme; a missing, empty, or non-bearer header yields `undefined` so the
 * upstream call goes out unauthenticated and the API's own error surfaces.
 *
 * The token is restricted to printable, space-free ASCII (0x21-0x7e): this
 * matches every real bearer/API-key charset (hex, base64url, etc.) and rejects
 * control characters such as CR/LF, closing off header-injection before the
 * value is placed into an outbound request header.
 */
export function relayedToken(): string | undefined {
  const raw = authStore.getStore()?.authorization ?? '';
  const match = /^Bearer\s+([\x21-\x7e]+)\s*$/i.exec(raw.trim());
  return match?.[1];
}
